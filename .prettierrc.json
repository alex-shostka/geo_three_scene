{
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 120,
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-css-order", "prettier-plugin-packagejson"],
  "importOrder": ["<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "^\\.\\./", "^\\./"],
  "cssDeclarationSorterOrder": "smacss"
}
