{
  "name": "geo_three_scene",
  "version": "1.0.0",
  "private": true,
  "description": "Debugging tool for map tiles: shows which tiles a Cesium globe loaded, which ones failed and what data they carry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-shostka/GEO_THREE_SCENE.git"
  },
  "license": "ISC",
  "author": "Alex Shostka (https://github.com/alex-shostka)",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "jscpd": "npx -y jscpd@5 src --min-tokens 50 --ignore \"**/*.test.ts\"",
    "madge": "npx -y madge@8 --circular --extensions ts,tsx src",
    "prepare": "husky",
    "preview": "vite preview",
    "stylelint": "stylelint \"**/*.css\" --fix",
    "stylelint:check": "stylelint \"**/*.css\"",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cesium": "^1.141.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.3.0",
    "three": "^0.185.1",
    "web-vitals": "^6.0.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^5.0.2"
  }
}
